\ProvidesPackage{tikzquack}[2026/11/07 version 1.0]
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}

\makeatletter

% comando per definire i colori di un nuovo papero
\newcommand{\@paperi}{}
\newcommand{\newpapero}[3]{%
	\definecolor{#1/primary}{HTML}{#2}%
	\definecolor{#1/secondary}{HTML}{#3}%
	\expandafter\newif\csname ifpapero@#1\endcsname%
	\listadd{\@paperi}{#1}
	\pgfkeys{
		/papero/#1/.is if=papero@#1
	}
}
% definisco colori dei paperi più famosi (o almeno quelli che mi ricordo in questo momento)
\newpapero{peppone}{3796b2}{8ab3b7}
\newpapero{peppe}{eeca96}{b58476}
\newpapero{piumotta}{d6a948}{d3905c}
\newpapero{otto}{242424}{bd740d}
\newpapero{ottone}{242424}{bd740d}

% comando per definire visuali nuove
\newcommand{\@viewspaperi}{}
\newcommand{\tikzquack@registerview}[1]{%
	\expandafter\newif\csname ifpapero@visuale@#1\endcsname%
	\listgadd{\@viewspaperi}{#1}
	\pgfkeys{
		/papero/#1/.is if=papero@visuale@#1
	}
}

\newcommand{\papero@reset}[1]{%
	\csname ifpapero@#1false\endcsname
}
\newcommand{\papero@resetview}[1]{%
	\csname papero@visuale@#1false\endcsname
}
\newcommand{\papero@check}[1]{%
	\csname ifpapero@#1\endcsname
		\colorlet{primary}{#1/primary}%
		\colorlet{secondary}{#1/secondary}%
		\colorlet{ribbon}{#1/secondary}%
		\def \papero@selectedpapero{#1}
	\fi
}
\newcommand{\papero@checkvisuale}[1]{%
	\csname ifpapero@visuale@#1\endcsname
		\def \papero@selectedview{#1}
	\fi
}
\newif\ifpapero@noribbon
\NewDocumentCommand{\papero@init}{ O{} }{%
	\forlistloop{\papero@reset}{\@paperi}
	\forlistloop{\papero@resetview}{\@viewspaperi}
		
	\pgfkeys{
		/papero/.cd,
		primary/.initial=\pgfkeysnovalue,
		secondary/.initial=\pgfkeysnovalue,
		eyecolor/.initial=\pgfkeysnovalue,
		ribboncolor/.initial=\pgfkeysnovalue,
		no ribbon/.is if=papero@noribbon,
		% per forwarding opzioni a tikz
		.search also=/tikz,
		#1
	}	
	
	% imposto default (Peppone)
	\def \papero@selectedpapero{peppone}
	\csname papero@\papero@selectedpapero true\endcsname
	\forlistloop{\papero@check}{\@paperi}	
	
	\def\noval{\pgfkeysnovalue}
	\pgfkeysgetvalue{/papero/primary}{\papero@primarycolor}
	\unless\ifx\papero@primarycolor\noval
		\colorlet{primary}{\papero@primarycolor}%
	\fi
	\pgfkeysgetvalue{/papero/secondary}{\papero@secondarycolor}
	\unless\ifx\papero@secondarycolor\noval
		\colorlet{secondary}{\papero@secondarycolor}%
	\fi
	\pgfkeysgetvalue{/papero/eyecolor}{\papero@eyecolor}
	\unless\ifx\papero@eyecolor\noval
		\colorlet{eyes}{\papero@eyecolor}%
	\else
		\colorlet{eyes}{black}%
	\fi
	\pgfkeysgetvalue{/papero/ribboncolor}{\papero@ribboncolor}
	\unless\ifx\papero@ribboncolor\noval
		\colorlet{ribbon}{\papero@ribboncolor}%
	\else
		\colorlet{ribbon}{secondary}%
	\fi	

	\def \papero@selectedview{top}
	\forlistloop{\papero@checkvisuale}{\@viewspaperi}
}

\newcommand*{\papero}[1][]{%
	\begingroup
	\begin{scope}
	\papero@init[#1]
	\csname papero@visuale@\papero@selectedview\endcsname[#1]
	% se ci sono eventuali customizzazioni per la coppia (vista, papero) selezionata, le applichiamo
	% (devono essere definite con una macro \papero@visuale@<nome_vista>@@<nome_papero>
	\ifcsname papero@visuale@\papero@selectedview @@\papero@selectedpapero\endcsname
		\csname papero@visuale@\papero@selectedview @@\papero@selectedpapero\endcsname
	\fi
	\end{scope}
	\endgroup
}

